# Local operator configuration; copy to .env, which is ignored by Git.
# Students never enter provider keys. Use a provider plan permitted for hosted apps.
STUDYORBIT_MODE=development
STUDYORBIT_PORT=3214
STUDYORBIT_API_KEY=
STUDYORBIT_BASE_URL=https://provider.example/v1
STUDYORBIT_MODEL=
# Production additionally requires an HTTPS STUDYORBIT_ORIGIN, a persistent
# STUDYORBIT_SESSION_SECRET (32+ characters), STUDYORBIT_INVITE_CODE (12+),
# and STUDYORBIT_DATABASE on a protected persistent disk. See README.md.
# Never commit the filled .env, database, signing files or student backups.
